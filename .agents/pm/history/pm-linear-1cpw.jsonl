{"hash_algorithm":"sha256","ts":"2026-10-23T10:26:12.128Z","author":"claude-orchestrator","author_source":"asserted","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"a99c959e4181618736dc4ee4","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.309","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-10-23T10:26:12.128Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-10-23T10:26:12.128Z","author":"claude-orchestrator","text":"Revert proof: with the previous release.yml the new squash-suffix assertions fail (release-decision 0/1); with the fix 1/1. The stranded release commit 56123c1 (#164) is reverted in the same PR, so main returns to the 2026.10.21 release metadata and the next dispatched release publishes 2026.10.23 cleanly. Root cause of the merge: approve-bot-pr-runs.sh armed auto-merge on the parked release PR after its job had exited; the helper now only approves release PR runs."}]}],"before_hash":"cf067fbefd023fa5496f7326f3ed10437b2681fd3ad374221c33c7170c44f0a0","after_hash":"60fdbaced78d440bf1b10ffbd70ff764f89674b7774e0630c5ac45fced0abc41","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"a56e80258d9ee7b1c61c8d3a45b51b2296ab070d76e305b2a69b86bc265ebf8f"}
