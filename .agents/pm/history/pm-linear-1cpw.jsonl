{"hash_algorithm":"sha256","ts":"2026-10-23T10:25:31.019Z","author":"claude-orchestrator","author_source":"asserted","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"a99c959e4181618736dc4ee4","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null,"version":{"value":"2.1.309","source":"probe"}},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-linear-1cpw"},{"op":"add","path":"/metadata/title","value":"Release recovery refuses a release commit merged with the GitHub squash suffix"},{"op":"add","path":"/metadata/description","value":"The Daily Release of 2026-10-23 timed out waiting for its release PR (#164), whose CI was parked on workflow approval; an hourly helper then auto-merged #164 as 'Release pm-linear v2026.10.23 (#164)'. The recovery path reads the tag from that subject, so the ' (#164)' suffix made it refuse with 'package.json is ahead of v2026.10.21 without a recognized release commit', leaving 2026.10.23 metadata on main and nothing on npm. Fix: strip a trailing ' (#N)' before validating the tag, and revert the stranded release commit so the next run releases cleanly."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-10-23T10:25:31.019Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-23T10:25:31.019Z"},{"op":"add","path":"/metadata/author","value":"claude-orchestrator"},{"op":"add","path":"/metadata/acceptance_criteria","value":"Subjects with and without a trailing (#N) parse to the same tag; malformed suffixes still refuse; main returns to the 2026.10.21 release metadata; the next dispatched release publishes 2026.10.23"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"085620ffd5518ebc0528023a5efaca1f7bc4f0c00ed305638d074e0362a1a0fd","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"1902ba438e50b499862cd194dfbe8a2cbcaab0d36570a71b51c34ffad2806a44"}
