{"hash_algorithm":"sha256","ts":"2026-10-27T09:45:22.258Z","author":"codex-agent","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"df333352dab165c42d9c1fcd","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"xhigh","source":"probe"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-linear-atomic-replay-revision"},{"op":"add","path":"/metadata/title","value":"Revalidate current target revisions before recovering an atomic Linear import"},{"op":"add","path":"/metadata/description","value":"Read-only synthetic scratch probe during field ownership work: atomic import commits input A; a peer then changes the target title through the SDK; replaying A uses the same transaction id and reports recovered while current SDK state still differs from A. Existing content-keyed recovery is not a current-state acknowledgement. This is inherited import behavior and is not changed by the observational preview."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":["replay","revision","sync"]},{"op":"add","path":"/metadata/created_at","value":"2026-10-27T09:45:22.258Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-27T09:45:22.258Z"},{"op":"add","path":"/metadata/author","value":"codex-agent"},{"op":"add","path":"/metadata/acceptance_criteria","value":"Bind import retry decisions to current SDK target revisions; revalidate every expected revision before recovery; decide unchanged through current target reads; preserve peer edits or surface a typed refusal; seeded model tests cover older-input replays and interleavings without git."}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"5fcaff29