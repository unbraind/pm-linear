{"hash_algorithm":"sha256","ts":"2026-10-22T15:37:41.025Z","author":"codex-agent","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"0ba29191cde459f80da12b65","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":null,"topic":null},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-10-22T15:37:41.025Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-10-22T15:37:41.025Z","author":"codex-agent","text":"No matching issue found in canceled/duplicate state searches. Linear published GraphQL schema documents canceled and duplicate as terminal workflow type values. The shared mapper now maps those types to closed and also recognizes Canceled in the name fallback, retaining cancelled compatibility. Added three regressions: 3/3 pass; reverting only mapStatus to the base function makes all 3 fail, restoring makes 3/3 pass. Typecheck, test typecheck and docstring lint pass. Schema versions now also hash resolved mappings so future mapping-algorithm changes invalidate old plans. Parent context: pm-linear-schema-drift."}]}],"before_hash":"9ea6a6dfe11fa27a17cc68f593963b3d746913b3de2d326de00b9f3ade78c33b","after_hash":"f22fd52f0c1dd9ac64c6218f9139bb5e44b0c10d4e6c7396d0ed83736d512302","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"9a06798975c62505241b7df5d9bd7f8d9ad5d05bd86df323839db66f79bd6cc7"}
