{"ts":"2026-08-10T06:06:04.494Z","author":"claude","author_source":"asserted","agent_harness":"claude-code","agent_instance":"507208966ab0dc1f88c5707f","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"},"role":{"value":"1","source":"environment"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-linear-lonp"},{"op":"add","path":"/metadata/title","value":"The shared script launcher skipped every gate it guarded when a path could not be resolved"},{"op":"add","path":"/metadata/description","value":"isMainInvocation caught a realpathSync failure and returned false, which makes runIfMain treat a direct invocation as a library import and skip main, so a required release check exits zero having done nothing."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":["docstrings","gate","release"]},{"op":"add","path":"/metadata/created_at","value":"2026-08-10T06:06:04.494Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-10T06:06:04.494Z"},{"op":"add","path":"/metadata/author","value":"claude"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"d83717695cfc3e5beee8945caa3001eba99fd9b60321e3405be40bed8bf0ee79","message":""}
{"ts":"2026-08-10T06:06:30.695Z","author":"claude","author_source":"asserted","agent_harness":"claude-code","agent_instance":"507208966ab0dc1f88c5707f","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"},"role":{"value":"1","source":"environment"},"topic":null},"op":"note_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-08-10T06:06:30.695Z"},{"op":"add","path":"/metadata/notes","value":[{"created_at":"2026-08-10T06:06:30.695Z","author":"claude","text":"The refactor into script-launcher.ts is why the fleet-wide sweep missed this repo. A survey that grepped scripts/docstring-gate.ts for realpathSync found nothing here, because the guard had moved into the shared launcher and the gate merely re-exports it. Factoring a defect out of the file people search makes it invisible to the search."}]}],"before_hash":"d83717695cfc3e5beee8945caa3001eba99fd9b60321e3405be40bed8bf0ee79","after_hash":"69e2367d836822c37b6d425dca48518d104dc428db5b088e2fe9be69291699d6"}
{"ts":"2026-08-10T06:06:31.150Z","author":"claude","author_source":"asserted","agent_harness":"claude-code","agent_instance":"507208966ab0dc1f88c5707f","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"},"role":{"value":"1","source":"environment"},"topic":null},"op":"note_add","patch":[{"op":"add","path":"/metadata/notes/1","value":{"created_at":"2026-08-10T06:06:31.150Z","author":"claude","text":"Unlike the copies in other repositories this variant resolves both sides through realpathSync, deliberately, to normalise Windows drive-letter casing. That reasoning is sound and was kept. Only the catch was removed, so the fix does not reintroduce the casing bug the both-sides comparison exists to prevent."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-08-10T06:06:31.150Z"}],"before_hash":"69e2367d836822c37b6d425dca48518d104dc428db5b088e2fe9be69291699d6","after_hash":"a62c0754a976597f2880898e12b929880832dc3e8247a7cf2cb1421f85a48181"}
