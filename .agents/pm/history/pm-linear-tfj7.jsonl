{"ts":"2026-09-05T17:39:37.407Z","author":"pi-orchestrator","author_source":"asserted","agent_harness":"claude-code","agent_model":"claude-opus-5","agent_model_source":"probe","agent_instance":"d8dbc6c3b8a673148b5c3e78","agent_provenance":{"model":{"value":"claude-opus-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.261","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-09-05T17:39:37.407Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-09-05T17:39:37.407Z","author":"pi-orchestrator","text":"pm-changelog 2026.9.2 stopped stamping the clock on an unflagged run: the heading is now the bare '## <version>' instead of '## <version> - <today>'. scripts/verify-release-changelog-date.ts asserted the clock form as its control, so the gate failed against a generator that had fixed the very defect the date-from-version flag exists to avoid. The control now asserts only that the unflagged heading differs from the flagged one, which is the property that actually proves the flag is load-bearing, and it accepts either generator. Verified by reverting the source change (4 tests fail) and restoring it (22 pass)."}]}],"before_hash":"998ed8454d86c23045ba69215c328f5bf7f6b3bca7940c39b34a1951f501fedc","after_hash":"3756feb77730c887add5654478d94308ce9b4d477a563c729ca85b6c0be13161","item_hash_version":3,"event_class":"substantive","record_hash_version":1,"record_hash":"73ed7b74175c723643780dbcbd03171cc13579f04af92a256d1c5beca8d6840d"}
