  node --test --test-name-pattern 'source isolation precedes SDK' test/dependency-closure.test.ts test/ownership.test.ts,project,pi-toolchain-glm-1103,"2026-11-03T12:56:55.228Z",local_mutation,dependabot/npm_and_yarn/pm-toolchain-82f052e758
