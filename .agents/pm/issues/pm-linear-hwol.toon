tests[2]:
  - command: npm test
    path: test/smoke.test.ts
    scope: project
    note: "Asserts registerPreflight is a scoped object whose commands array equals pm-linear's owned mutating command paths (linear sync, linear import, linear export) and run is a function. Test title: preflight override is scoped to pm-linear's owned command paths"
  - command: npx tsx --test test/smoke.test.ts
    scope: project
    timeout_seconds: 300
    assert_stdout_contains[1]: preflight override is scoped to
    assert_stdout_regex[1]: fail 0$
    note: "Bidirectional scope-classifier binding over 13 invocations. Non-vacuous: reverting either dry-run edge fails (verified 2026-08-15)."
close_reason: completed
body: ""
