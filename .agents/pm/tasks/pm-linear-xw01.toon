  - command: "node --input-type=module -e 'import assert from \"node:assert/strict\"; import { readFileSync } from \"node:fs\"; import { execFileSync } from \"node:child_process\"; const main = (path) => execFileSync(\"git\", [\"show\", \"origin/main:\" + path], { encoding: \"utf8\" }); const read = (path) => process.env.REVIEW_EVIDENCE_REF ? execFileSync(\"git\", [\"show\", process.env.REVIEW_EVIDENCE_REF + \":\" + path], { encoding: \"utf8\" }) : readFileSync(path, \"utf8\"); const paths = [\".agents/pm/tasks/pm-linear-xw01.toon\", \".agents/pm/chores/pm-linear-2cy6.toon\"].filter(path => !process.env.REVIEW_ITEM || path.includes(process.env.REVIEW_ITEM)); assert.ok(paths.length > 0); for (const path of paths) { const item = read(path); assert.match(item, /^status: (open|in_progress)$/m, path + \" must remain active\"); assert.doesNotMatch(item, /^(close_reason|closed_at|completed_at):/m, path + \" must not claim completion\"); assert.equal(item.match(/^acceptance_criteria:.*$/m)?.[0], main(path).match(/^acceptance_criteria:.*$/m)?.[0], \"acceptance criteria must remain unchanged\"); if (path.includes(\"xw01\")) { assert.match(item, /99\\.29% lines, 96\\.67% branches and 100% functions/); assert.match(item, /^resolution:.*unmet/m); } else { assert.match(main(path), /corrects the earlier zero-warning receipt/); assert.match(item, /^resolution:.*unproven/m); } console.log(\"PASS evidence \" + path); } const baseline = JSON.parse(main(\"package.json\")).coverageGate.thresholds; assert.deepEqual(baseline, { lines: 99, branches: 96, functions: 100 }); assert.deepEqual(JSON.parse(readFileSync(\"package.json\", \"utf8\")).coverageGate.thresholds, baseline); console.log(\"PASS unchanged main coverage thresholds 99/96/100\");'"
